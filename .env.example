# Vercel AI Gateway — https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Vercel Blob — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Model slugs (Vercel AI Gateway provider/model format)
DESIGNER_MODEL=deepseek/deepseek-v4-flash-vision-exp
IMAGE_MODEL=google/gemini-3.1-flash-image

# Output aspect ratio follows the uploaded room photo (closest ratio Gemini accepts).
# Gemini resolution: low → 512, medium or auto → 1K, high → 2K
IMAGE_QUALITY=high
